<Window
    x:Class="RickAndMortyWiki.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Rick And Morty Wiki"
    Width="800"
    Height="430"
    AllowsTransparency="True"
    Background="Transparent"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Border
            x:Name="WindowBck"
            Background="#bdd8e1"
            CornerRadius="14"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <!--#region COLUMNS ROWS-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <!--#endregion-->
                <!--#region HEADER-->

                <Image
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Width="180"
                    Height="40"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Source="/images/RicknMortyLOGO.png" />
                <Border
                    Grid.Column="5"
                    Width="40"
                    Height="40"
                    Margin="15"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#904b42"
                    CornerRadius="8"
                    Cursor="Hand">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Close_Click">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Foreground="White"
                            Kind="Close" />
                    </Button>
                </Border>
                <Border
                    x:Name="ColorBtn"
                    Grid.Column="5"
                    Width="40"
                    Height="40"
                    Margin="10,20,15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#fef7ff"
                    CornerRadius="8"
                    Cursor="Hand">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ChangeMode_Click">
                        <materialDesign:PackIcon
                            x:Name="colorBtn"
                            Width="20"
                            Height="20"
                            Foreground="Black"
                            Kind="WbSunny" />
                    </Button>
                </Border>
                <!--#endregion-->
                <!--#region Search-->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Width="500"
                    Height="40"
                    Margin="0,0,0,5"
                    VerticalAlignment="Bottom"
                    Background="LightGray"
                    CornerRadius="20">
                    <TextBox x:Name="txtSearch" />
                </Border>
                <Border
                    Grid.Row="0"
                    Grid.Column="4"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Blue"
                    CornerRadius="100">
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Search_Click">
                        <materialDesign:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="Search" />
                    </Button>

                </Border>
                <!--#endregion-->
                <!--#region Filters-->
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal">
                    <RadioButton
                        x:Name="rbCharacter"
                        Margin="0,0,20,0"
                        Content="Characters"
                        IsChecked="True" />

                    <RadioButton
                        x:Name="rbEpisode"
                        Margin="0,0,20,0"
                        Content="Episodes" />

                    <RadioButton x:Name="rbLocation" Content="Locations" />
                </StackPanel>
                <!--#endregion-->
                <!--#region Cards-->
                <StackPanel
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="6">
                    <DataGrid
                        x:Name="dgResults"
                        Height="300"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding Characters}"
                        MouseDoubleClick="dgResults_MouseDoubleClick"
                        SelectedItem="{Binding CharacterSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Id}"
                                Header="ID" />

                            <DataGridTemplateColumn Width="120" Header="Foto">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Image
                                            Width="80"
                                            Height="80"
                                            Source="{Binding image}"
                                            Stretch="UniformToFill" />

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Name}"
                                Header="Nome" />

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Status}"
                                Header="Status" />

                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding species}"
                                Header="Espécie" />

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
                <!--#endregion-->

            </Grid>

        </Border>
        <Grid
            x:Name="GridEditView"
            Background="#9000"
            Visibility="Hidden">
            <Border
                Margin="200,20"
                Background="#bdd8e1"
                CornerRadius="10">
                <Grid>
                    <StackPanel Margin="30">
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Name:" />
                            <TextBox x:Name="TbxName" Text="{Binding CharacterSelected.Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Status:" />
                            <TextBox x:Name="TbxStatus" Text="{Binding CharacterSelected.Status, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        x:Name="BtnCloseEditView"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="BtnCloseEditView_Click">
                        <materialDesign:PackIcon
                            Margin="5"
                            Padding="0"
                            Foreground="Red"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>