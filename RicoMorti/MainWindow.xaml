<Window x:Class="RicoMorti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RicoMorti"
        mc:Ignorable="d"
        Title="Rick and Morty" Height="400" Width="600">
    <Window.Resources>
        <Style TargetType="Button" x:Key="RoundedButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                            BorderBrush="#00bcd4"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#00bcd4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <!--#region ROWS/COLUMNS-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition />

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--#endregion-->
        <!--#region HEADER-->
        <Image Source="/fontbolt.png"
                Grid.Column="1"
               Grid.ColumnSpan="3"
               ></Image>
        <!--#endregion-->
        <!--#region Filter-->

        <Button 
            x:Name="CharBTN"
            Grid.Column="1"
            Grid.Row="1"
            Background="#9edfdb"
            BorderThickness="0"
            FontWeight="Black"
            FontSize="12"
            Foreground="Black" 
            Margin="-10,0,10,0"
            Click="Character_Click"
            VerticalAlignment="Center"
            Style="{StaticResource RoundedButton}">
            characters
        </Button>
         
        <Button 
            x:Name="LocBTN"
            Grid.Column="2"
            Grid.Row="1"
            Background="#9edfdb"
            BorderThickness="0"
            FontWeight="Black"
            FontSize="14"
            VerticalAlignment="Center"
            Foreground="Black" 
            Margin="-6,0,-6,0"
            Click="Location_Click"
            Style="{StaticResource RoundedButton}">
            location
        </Button>

        <Button 
            x:Name="EpiBTN"
           Grid.Column="3"
           Grid.Row="1"
           Background="#9edfdb"
           BorderThickness="0"
           FontWeight="Black"
           FontSize="14"
           Foreground="#000000" 
           VerticalAlignment="Center"
           Margin="10,0,-10,0"
            Click="Episodes_Click"
            Style="{StaticResource RoundedButton}">
            episodes
        </Button>


        <!--#endregion-->
        <!--#region Display Btn-->
        <Border
            x:Name= "colorBTN"
            Grid.Column="4"
            Grid.Row="0"
            Width="25"
            Height="25"
            BorderBrush="Black"
            BorderThickness="3"
            CornerRadius="100"
            Opacity=".4">
            <Button
                
                Background="Transparent"
                BorderThickness="0"
                Content="*"
                Click="ColorChanger_Click"/>

        </Border>
        <!--#endregion-->
    </Grid>
</Window>
